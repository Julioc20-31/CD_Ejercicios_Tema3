classDiagram
    class Base_de_datos {
        -String url
        +anadir_publicacion(String) Publicacion
    }
    
    class Publicacion {
        <<abstract>>
        -String nombre
        -Date fecha
    }
    
    class Articulo_de_conferencia {
        -int num_paginas
    }
    
    class Capitulo_de_libro {
        -int num_capitulo
    }
    
    class Libro {
        -int(4) ISBN
    }
    
    class Proceedings {
        -String lugar_conferencia
    }
    
    class Autores {
        -String nombre
        -String correo_electronico
        -String entidad
        +anadir_entidad(String) void
    }

     1. HERENCIA 
    Publicacion <|-- Articulo_de_conferencia
    Publicacion <|-- Capitulo_de_libro
    Publicacion <|-- Libro
    Libro <|-- Proceedings

    2. COMPOSICIÓN 
    Base_de_datos "1" *-- "*" Publicacion : se componen de
    Libro "1" *-- "*" Capitulo_de_libro : contienen
    Proceedings "1" *-- "*" Articulo_de_conferencia : compuestos por

     3. ASOCIACIÓN NORMAL 
    Autores "*" --> "*" Articulo_de_conferencia : escriben
    Autores "*" --> "*" Base_de_datos : consultan